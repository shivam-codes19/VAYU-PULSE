{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|sw\\.js|workbox-.*|manifest\\.webmanifest|icon\\.svg|pwa-.*|apple-touch-icon\\.png|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
